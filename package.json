{
  "name": "evolutivex-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plugin de Claude Code: narración por voz con AI Voice-InterConnector, notificaciones de escritorio nativas y transcript enriquecido opt-in.",
  "author": "Cristián Rojas Arredondo",
  "license": "MPL-2.0",
  "engine": {
    "aiVoiceInterConnector": "0.42.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "check-dist": "node build.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node test.mjs",
    "test:transcript": "node build.mjs && claude plugin test .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/node-notifier": "^8.0.5",
    "commander": "^13.1.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "node-notifier": "^10.0.1",
    "prettier": "3.9.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0"
  }
}
